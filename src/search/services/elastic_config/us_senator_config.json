{
    "settings": {
        "analysis": {
            "analyzer": {
                "name_analyzer": {
                    "type": "english",
                    "stopwords": "_english_"
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "description": {"type": "text"},
            "person": {
                "properties": {
                    "first_name": {"type": "text", "analyzer": "name_analyzer"},
                    "last_name": {"type": "text", "analyzer": "name_analyzer"},
                    "birth_date": {"type": "date"}
                }
            },
            "state": {"type": "text"},
            "political_party": {"type": "text"},
            "phone_number": {"type": "text"},
            "website": {"type": "text"},
            "term_end_date": {"type": "date"}
        }
    }
}